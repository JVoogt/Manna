---
// Footer component with contact information
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-content">
      <div class="footer-section brand-section">
        <h2 class="footer-brand">Manna Kitchen</h2>
        <p class="footer-tagline">Fresh homemade platters and weekly meals</p>
      </div>

      <div class="footer-section contact-section">
        <h3 class="footer-heading">Contact</h3>
        <div class="contact-info">
          <a href="https://wa.me/27825795210" class="contact-link whatsapp-link" target="_blank" rel="noopener noreferrer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M12 0C5.373 0 0 5.373 0 12c0 2.121.552 4.114 1.521 5.843L0.25 23.75l6.141-1.243A11.914 11.914 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0z" fill="#25D366"/>
              <path d="M17.75 6.188c-1.334-1.335-3.108-2.071-4.994-2.071-3.993 0-7.242 3.249-7.242 7.242 0 1.276.332 2.521.965 3.618L5.25 18.75l3.896-1.121a7.205 7.205 0 003.412.871h.003c3.993 0 7.242-3.249 7.242-7.242 0-1.938-.757-3.761-2.053-5.07zM12.656 17.344a6.004 6.004 0 01-3.065-.838l-.22-.131-2.279.597.608-2.224-.143-.229a6.012 6.012 0 01-.919-3.207c0-3.319 2.701-6.02 6.02-6.02 1.608 0 3.119.627 4.255 1.765s1.765 2.647 1.765 4.255c-.003 3.32-2.703 6.032-6.022 6.032zm3.301-4.504c-.181-.09-1.072-.529-1.238-.589-.165-.06-.286-.09-.407.091-.121.181-.468.589-.574.71-.105.121-.211.136-.392.045-.181-.09-.764-.282-1.454-.898-.538-.479-.901-1.071-1.006-1.252-.106-.181-.011-.279.079-.369.082-.082.181-.211.271-.316.091-.106.121-.181.181-.302.061-.121.03-.226-.015-.316-.045-.091-.407-.981-.558-1.343-.146-.353-.296-.305-.407-.31-.106-.006-.227-.007-.347-.007s-.316.045-.483.227c-.165.181-.633.619-.633 1.51s.648 1.751.738 1.872c.091.121 1.276 1.949 3.092 2.734.432.186.769.298 1.032.381.434.137.828.118 1.141.072.348-.052 1.072-.438 1.223-.861.151-.423.151-.786.106-.861-.045-.075-.166-.121-.347-.211z" fill="white"/>
            </svg>
            <span>+27 82 579 5210</span>
          </a>
          <div class="contact-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="currentColor"/>
            </svg>
            <span>Pretoria North</span>
          </div>
        </div>
      </div>

      <div class="footer-section links-section">
        <h3 class="footer-heading">Quick Links</h3>
        <nav aria-label="Footer navigation">
          <ul class="footer-links">
            <li><a href="/">Home</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </nav>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">&copy; 2026 Manna Kitchen. All rights reserved.</p>
      <p class="tagline">Made with love in Pretoria North</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: linear-gradient(135deg, #6b4423 0%, #8b5a3c 100%);
    color: white;
    margin-top: auto;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 1.5rem;
  }

  .footer-content {
    display: grid;
    gap: 2rem;
    margin-bottom: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .footer-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-brand {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
    color: white;
    letter-spacing: 0.5px;
  }

  .footer-tagline {
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.95rem;
    margin: 0;
    line-height: 1.5;
  }

  .footer-heading {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
    color: #d4a574;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-link,
  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: white;
    text-decoration: none;
    font-size: 1rem;
    /* Minimum 44px tap target for mobile */
    min-height: 44px;
  }

  .contact-link {
    transition: opacity 0.2s, transform 0.1s;
    padding: 0.5rem 0;
  }

  .contact-link:hover {
    opacity: 0.9;
    transform: translateX(2px);
  }

  .whatsapp-link svg path:first-child {
    fill: #25D366;
  }

  .contact-item {
    padding: 0.5rem 0;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a {
    color: white;
    text-decoration: none;
    transition: color 0.2s;
    display: block;
    padding: 0.5rem 0;
    /* Minimum 44px tap target for mobile */
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .footer-links a:hover {
    color: #d4a574;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 1.5rem;
    text-align: center;
  }

  .copyright {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 0.5rem 0;
  }

  .tagline {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
    font-style: italic;
    margin: 0;
  }

  /* Mobile responsive */
  @media (max-width: 640px) {
    .footer-container {
      padding: 2rem 1rem 1rem;
    }

    .footer-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .footer-brand {
      font-size: 1.25rem;
    }

    .footer-heading {
      font-size: 1rem;
    }

    .contact-link,
    .contact-item,
    .footer-links a {
      font-size: 0.95rem;
    }
  }

  /* Tablet responsive */
  @media (min-width: 641px) and (max-width: 1024px) {
    .footer-content {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Desktop - 3 columns */
  @media (min-width: 1025px) {
    .footer-content {
      grid-template-columns: 2fr 1fr 1fr;
    }

    .brand-section {
      max-width: 350px;
    }
  }
</style>
