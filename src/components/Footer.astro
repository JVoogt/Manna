---
import { WA_BASE, WA_DISPLAY, ADDRESS, FOUNDERS } from '../lib/site';
---

<footer class="foot">
  <div class="container foot__wrap">
    <p class="foot__name">Manna Kitchen</p>
    <div class="foot__colophon">
      <address>
        {ADDRESS.street}, {ADDRESS.suburb}, {ADDRESS.area}, {ADDRESS.postalCode}.
        WhatsApp <a href={WA_BASE} target="_blank" rel="noopener noreferrer">{WA_DISPLAY}</a>.
        Cooked by {FOUNDERS[0]} and {FOUNDERS[1]}.
      </address>
    </div>
    <nav class="foot__links" aria-label="Footer">
      <a href="/#menu">Frozen meals menu</a>
      <a href="/#how">How it works</a>
      <a href="/#faq">FAQ</a>
      <a href="/about/">Our story</a>
      <a href="/contact/">Contact</a>
      <a href={WA_BASE} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    </nav>
    <small class="foot__legal">&copy; 2026 Manna Kitchen</small>
  </div>
</footer>

<style>
  .foot { border-top: 1px solid var(--color-rule-2); padding-block: var(--space-2xl) var(--space-xl); }
  .foot__wrap { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); column-gap: var(--gap-columns); row-gap: var(--space-lg); align-items: start; }
  .foot__name { font: var(--display-weight) var(--text-xl)/1.1 var(--font-display); letter-spacing: var(--tracking-display); color: var(--color-ink); }
  .foot__colophon { display: grid; gap: var(--space-sm); color: var(--color-ink-2); max-width: 60ch; }
  .foot__colophon address { font-style: normal; }
  .foot__colophon a { display: inline-block; padding-block: var(--space-xs); color: var(--color-ink); }
  .foot__links { grid-column: 2; display: flex; flex-wrap: wrap; gap: 0 var(--space-lg); }
  .foot__links a { display: inline-flex; align-items: center; min-height: var(--tap); color: var(--color-ink); text-decoration: underline; text-decoration-color: var(--color-rule-2); }
  .foot__links a:hover { text-decoration-color: var(--color-accent); }
  .foot__legal { grid-column: 2; font-size: var(--text-sm); color: var(--color-muted); }
  @media (max-width: 60rem) {
    .foot__wrap { grid-template-columns: minmax(0, 1fr); }
    .foot__links, .foot__legal { grid-column: 1; }
  }
</style>
