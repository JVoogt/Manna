<footer class="site-foot">
  <div class="sf-inner">
    <div class="sf-brand">
      <span class="sf-logo">Manna</span>
      <p>Fresh homemade platters and weekly meals. Pretoria North.</p>
    </div>
    <div class="sf-col">
      <h4>Menu</h4>
      <a href="/#pick">Build a platter</a>
      <a href="/#weekly-meals">Weekly meals</a>
    </div>
    <div class="sf-col">
      <h4>About</h4>
      <a href="/#about">Our story</a>
      <a href="/#how">How it works</a>
      <a href="/#faq">FAQ</a>
      <a href="/about/">About us</a>
    </div>
    <div class="sf-col">
      <h4>Contact</h4>
      <a href="https://wa.me/27825795210" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a href="/contact/">Contact form</a>
      <span>71 Springbok St, Theresapark</span>
    </div>
  </div>
  <div class="sf-bot">
    <span>&copy; 2026 Manna Kitchen</span>
    <span>Made with love in Theresapark</span>
  </div>
</footer>

<style>
  .site-foot {
    background: var(--paper);
    border-top: 1px solid var(--line-2);
    padding: 3rem 1.5rem 2rem;
  }

  .sf-inner {
    max-width: var(--content-w);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2rem;
  }

  .sf-brand { max-width: 320px; }

  .sf-logo {
    font-family: var(--font-display);
    font-weight: 700;
    font-style: italic;
    font-size: 2rem;
    letter-spacing: -0.03em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .sf-brand p {
    color: var(--ink-mute);
    font-size: 0.9rem;
    margin: 0;
  }

  .sf-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sf-col h4 {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-mute);
    margin: 0 0 0.5rem;
    font-weight: 600;
  }

  .sf-col a, .sf-col span {
    font-size: 0.9rem;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .sf-col a:hover { color: var(--ink); }

  .sf-bot {
    max-width: var(--content-w);
    margin: 2rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-2);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    font-size: 0.8rem;
    color: var(--ink-mute);
    gap: 0.5rem;
  }

  @media (max-width: 780px) {
    .sf-inner { grid-template-columns: 1fr 1fr; }
    .sf-brand { grid-column: 1 / -1; }
  }

  @media (max-width: 480px) {
    .sf-inner { grid-template-columns: 1fr; }
  }
</style>
