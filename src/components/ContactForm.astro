---
// Contact form component - static for now, will need backend integration later
---

<div class="contact-form-wrapper">
  <div class="form-notice">
    <p>
      <strong>For orders, please use WhatsApp - it's faster!</strong>
    </p>
    <p>Use this form for general inquiries only.</p>
  </div>

  <form class="contact-form" method="POST" action="">
    <div class="form-group">
      <label for="name">
        Your Name <span class="required">*</span>
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        placeholder="Jane Smith"
      />
    </div>

    <div class="form-group">
      <label for="email">
        Email Address <span class="required">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        placeholder="jane@example.com"
      />
    </div>

    <div class="form-group">
      <label for="phone">
        Phone Number <span class="optional">(optional)</span>
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        placeholder="+27 82 123 4567"
      />
    </div>

    <div class="form-group">
      <label for="message">
        Message <span class="required">*</span>
      </label>
      <textarea
        id="message"
        name="message"
        required
        rows="6"
        placeholder="Tell us what you'd like to know..."
      ></textarea>
    </div>

    <button type="submit" class="submit-button">
      Send Message
    </button>
  </form>
</div>

<style>
  .contact-form-wrapper {
    max-width: 600px;
    margin: 2rem auto;
  }

  .form-notice {
    background: #fff4e6;
    border-left: 4px solid #d4a574;
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    border-radius: 4px;
  }

  .form-notice p {
    margin: 0.5rem 0;
    color: #6b4423;
    font-size: 1rem;
  }

  .form-notice p:first-child {
    margin-top: 0;
  }

  .form-notice p:last-child {
    margin-bottom: 0;
    font-size: 0.9rem;
    opacity: 0.9;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  label {
    font-size: 1rem;
    font-weight: 600;
    color: #6b4423;
    margin-bottom: 0.5rem;
  }

  .required {
    color: #c85a3c;
  }

  .optional {
    font-weight: 400;
    font-size: 0.9rem;
    color: #8b7355;
  }

  input,
  textarea {
    font-family: inherit;
    font-size: 1rem;
    padding: 0.75rem;
    border: 2px solid #d4a574;
    border-radius: 6px;
    background: #fefefe;
    color: #4a3728;
    transition: border-color 0.2s, box-shadow 0.2s;
    min-height: 44px; /* Touch-friendly minimum */
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: #8b5a3c;
    box-shadow: 0 0 0 3px rgba(139, 90, 60, 0.1);
  }

  textarea {
    resize: vertical;
    min-height: 120px;
  }

  .submit-button {
    background: #8b5a3c;
    color: white;
    font-size: 1.125rem;
    font-weight: 600;
    padding: 1rem 2rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
    min-height: 44px; /* Touch-friendly */
    margin-top: 0.5rem;
  }

  .submit-button:hover {
    background: #6b4423;
  }

  .submit-button:active {
    transform: scale(0.98);
  }

  .submit-button:disabled {
    background: #c4a484;
    cursor: not-allowed;
    transform: none;
  }

  /* Mobile optimization */
  @media (max-width: 640px) {
    .contact-form-wrapper {
      padding: 0 1rem;
    }

    input,
    textarea {
      font-size: 16px; /* Prevents iOS zoom on focus */
    }

    .submit-button {
      font-size: 1rem;
    }
  }
</style>

<script>
  // Prevent double-submission
  const form = document.querySelector('.contact-form') as HTMLFormElement;
  const submitButton = form?.querySelector('.submit-button') as HTMLButtonElement;

  form?.addEventListener('submit', (e) => {
    submitButton.disabled = true;
    submitButton.textContent = 'Sending...';

    // Note: This will need backend integration
    // For now, prevent actual submission
    e.preventDefault();

    // Re-enable after demonstration
    setTimeout(() => {
      submitButton.disabled = false;
      submitButton.textContent = 'Send Message';
      alert('Form backend not yet implemented. Please use WhatsApp for now!');
    }, 500);
  });
</script>
