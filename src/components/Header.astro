---
import { CartIcon } from '../components/react/CartIcon';

// Get current path for active link highlighting
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-container">
    <div class="brand">
      <a href="/" class="brand-link">
        <span class="brand-name">Manna Kitchen</span>
      </a>
    </div>

    <div class="header-right">
      <nav class="nav">
        <ul class="nav-list">
          <li>
            <a
              href="/"
              class:list={["nav-link", { active: currentPath === "/" }]}
              aria-current={currentPath === "/" ? "page" : undefined}
            >
              Home
            </a>
          </li>
          <li>
            <a
              href="/about"
              class:list={["nav-link", { active: currentPath === "/about" || currentPath === "/about/" }]}
              aria-current={currentPath === "/about" || currentPath === "/about/" ? "page" : undefined}
            >
              About
            </a>
          </li>
          <li>
            <a
              href="/contact"
              class:list={["nav-link", { active: currentPath === "/contact" || currentPath === "/contact/" }]}
              aria-current={currentPath === "/contact" || currentPath === "/contact/" ? "page" : undefined}
            >
              Contact
            </a>
          </li>
        </ul>
      </nav>
      <CartIcon client:only="react" />
    </div>
  </div>
</header>

<style>
  .site-header {
    background: linear-gradient(135deg, #8b5a3c 0%, #6b4423 100%);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .brand-link {
    text-decoration: none;
    display: block;
  }

  .brand-name {
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
    letter-spacing: 0.5px;
  }

  .brand-link:hover .brand-name {
    opacity: 0.9;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav-list {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: block;
    padding: 0.75rem 1.25rem;
    color: white;
    text-decoration: none;
    font-weight: 500;
    font-size: 1rem;
    border-radius: 6px;
    transition: background 0.2s, transform 0.1s;
    /* Minimum 44px tap target for mobile */
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .nav-link:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-1px);
  }

  .nav-link.active {
    background: rgba(255, 255, 255, 0.2);
    font-weight: 600;
  }

  /* Mobile responsive - stack navigation on small screens */
  @media (max-width: 640px) {
    .header-container {
      flex-direction: column;
      gap: 1rem;
      padding: 1rem;
    }

    .brand-name {
      font-size: 1.25rem;
    }

    .nav-list {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.25rem;
    }

    .nav-link {
      padding: 0.625rem 1rem;
      font-size: 0.95rem;
    }
  }

  /* Tablet responsive */
  @media (min-width: 641px) and (max-width: 1024px) {
    .header-container {
      padding: 1rem 1.25rem;
    }

    .brand-name {
      font-size: 1.375rem;
    }
  }
</style>
