---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/#menu', label: 'Menu' },
  { href: '/#how', label: 'How it works' },
  { href: '/#story', label: 'Our story' },
  { href: '/#faq', label: 'FAQ' },
  { href: '/contact/', label: 'Contact', active: currentPath.startsWith('/contact') },
];
---

<header class="topbar" id="top">
  <div class="tb-inner">
    <a href="/" class="tb-brand" aria-label="Manna Kitchen, home">
      <span class="tb-logo" aria-hidden="true">M</span>
      <span class="tb-name">Manna Kitchen</span>
    </a>
    <nav class="tb-nav" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} class={l.active ? 'active' : ''} aria-current={l.active ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="tb-right">
      <div id="cart-icon-root"></div>
      <a href="https://wa.me/27825795210" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp tb-wa" aria-label="Chat on WhatsApp">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.5 14.3c-.3-.15-1.7-.84-2-.94-.27-.1-.47-.15-.66.15-.2.3-.76.94-.93 1.13-.17.2-.34.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.13.3-.34.44-.51.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.66-1.6-.9-2.18-.24-.58-.48-.5-.66-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.06 2.88 1.21 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.22 1.35.19 1.86.12.57-.08 1.74-.71 1.99-1.4.25-.69.25-1.28.17-1.4-.07-.13-.27-.2-.57-.35zM12 2C6.48 2 2 6.48 2 12c0 1.95.56 3.77 1.53 5.31L2 22l4.79-1.49A9.95 9.95 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2z"/>
        </svg>
        <span class="hide-sm">WhatsApp</span>
      </a>
      <details class="tb-menu">
        <summary aria-label="Menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <nav class="tb-drawer" aria-label="Mobile">
          {links.map((l) => (
            <a href={l.href} aria-current={l.active ? 'page' : undefined}>{l.label}</a>
          ))}
          <a href="/about/" aria-current={currentPath.startsWith('/about') ? 'page' : undefined}>About us</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklch, var(--paper) 92%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line-2);
  }

  .tb-inner {
    max-width: var(--content-w);
    margin: 0 auto;
    padding: 0.5rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .tb-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
    min-height: var(--tap);
  }

  .tb-logo {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.4rem;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    display: grid;
    place-items: center;
    line-height: 1;
    flex-shrink: 0;
  }

  .tb-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    white-space: nowrap;
  }

  .tb-nav {
    display: flex;
    gap: 0.25rem;
    margin-left: auto;
  }

  .tb-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 0.75rem;
    font-size: 1rem;
    color: var(--ink-soft);
    font-weight: 500;
    position: relative;
    white-space: nowrap;
  }

  .tb-nav a:hover, .tb-nav a.active { color: var(--ink); }

  .tb-nav a::after {
    content: "";
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.45rem;
    height: 2px;
    background: var(--accent-strong);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
  }

  .tb-nav a:hover::after, .tb-nav a.active::after { transform: scaleX(1); }

  .tb-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    border-radius: 999px;
    min-height: var(--tap);
    padding: 0 1.1rem;
    transition: transform 120ms ease, background-color 200ms ease;
    white-space: nowrap;
  }

  .btn-whatsapp {
    background: var(--wa-deep);
    color: var(--on-dark);
  }

  .btn-whatsapp:hover { background: var(--wa-deeper); }
  .btn-whatsapp:active { transform: translateY(1px); }

  .tb-menu { display: none; position: relative; }

  .tb-menu summary {
    list-style: none;
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: 50%;
    cursor: pointer;
    color: var(--ink);
  }
  .tb-menu summary::-webkit-details-marker { display: none; }
  .tb-menu summary:hover { background: var(--paper-2); }
  .tb-menu summary:active { background: var(--paper-3); }

  .tb-drawer {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    min-width: 14rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
  }

  .tb-drawer a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 1rem;
    border-radius: 10px;
    font-weight: 500;
    color: var(--ink);
  }
  .tb-drawer a:hover { background: var(--paper-2); }
  .tb-drawer a:active { background: var(--paper-3); }

  @media (max-width: 960px) {
    .tb-nav { display: none; }
    .tb-menu { display: block; }
    .tb-right { margin-left: auto; }
  }

  @media (max-width: 520px) {
    .hide-sm { display: none; }
    .btn { width: var(--tap); padding: 0; }
    .tb-name { font-size: 1.1rem; }
    .tb-inner { gap: 0.5rem; padding: 0.5rem 0.75rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tb-nav a::after { transition: none; }
    .btn { transition: none; }
  }
</style>
