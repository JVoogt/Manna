---
import { WA_HELLO } from '../lib/site';

const currentPath = Astro.url.pathname;
const links = [
  { href: '/#menu', label: 'Menu' },
  { href: '/#how', label: 'How it works' },
  { href: '/#story', label: 'Our story' },
  { href: '/#faq', label: 'FAQ' },
  { href: '/contact/', label: 'Contact', active: currentPath.startsWith('/contact') },
];
---

<header class="nav" id="top">
  <div class="container nav__wrap">
    <div class="nav__pill">
      <a href="/" class="nav__brand" aria-label="Manna Kitchen, home">Manna Kitchen</a>
      <nav class="nav__links" aria-label="Primary">
        {links.map((l) => (
          <a href={l.href} class={l.active ? 'is-active' : ''} aria-current={l.active ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>
      <div class="nav__right">
        <div id="cart-icon-root"></div>
        <a href={WA_HELLO} target="_blank" rel="noopener noreferrer" class="btn nav__wa">WhatsApp</a>
        <details class="nav__menu">
          <summary aria-label="Menu">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </summary>
          <nav class="nav__drawer" aria-label="Mobile">
            <a href={WA_HELLO} target="_blank" rel="noopener noreferrer" class="nav__drawer-wa">Order on WhatsApp</a>
            {links.map((l) => (
              <a href={l.href} aria-current={l.active ? 'page' : undefined}>{l.label}</a>
            ))}
            <a href="/about/" aria-current={currentPath.startsWith('/about') ? 'page' : undefined}>About us</a>
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: var(--space-sm);
    z-index: var(--z-sticky-nav);
    padding-block: var(--space-sm) var(--space-sm);
  }
  .nav__pill {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-md);
    min-height: 68px;
    padding: var(--space-2xs) var(--space-xs) var(--space-2xs) var(--space-lg);
    background: var(--color-paper);
    border: 1px solid var(--color-rule-2);
    border-radius: var(--radius-pill);
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font: var(--display-weight) 1.5rem/1 var(--font-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__links { display: flex; gap: var(--space-2xs); margin-left: auto; }
  .nav__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-sm);
    color: var(--color-ink-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__links a:hover { color: var(--color-ink); text-decoration: underline; text-decoration-color: var(--color-accent); text-decoration-thickness: 2px; }
  .nav__links a.is-active { color: var(--color-ink); text-decoration: underline; text-decoration-thickness: 2px; text-decoration-color: var(--color-accent); }
  .nav__right { display: flex; align-items: center; gap: var(--space-xs); }
  .nav__wa { min-height: var(--tap); padding: 0 var(--space-lg); }
  .nav__menu { display: none; }
  .nav__menu summary {
    list-style: none;
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: var(--radius-pill);
    cursor: pointer;
    color: var(--color-ink);
  }
  .nav__menu summary::-webkit-details-marker { display: none; }
  .nav__menu summary:hover { background: var(--color-paper-3); }
  .nav__menu summary:active { background: var(--color-paper-3); transform: translateY(1px); }
  .nav__drawer {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-sm));
    z-index: var(--z-dropdown);
    width: 16rem;
    display: flex;
    flex-direction: column;
    padding: var(--space-xs);
    background: var(--color-paper);
    border: 1px solid var(--color-rule-2);
    border-radius: var(--radius-card);
  }
  .nav__drawer a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-md);
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--radius-card);
  }
  .nav__drawer a:hover, .nav__drawer a:active { background: var(--color-paper-3); }
  .nav__drawer a[aria-current="page"] { text-decoration: underline; text-decoration-color: var(--color-accent); text-decoration-thickness: 2px; }
  .nav__drawer-wa { display: none !important; background: var(--color-accent); color: var(--color-accent-ink) !important; font-weight: 600; margin-bottom: var(--space-2xs); }
  .nav__drawer-wa:hover { background: var(--accent-hover) !important; }

  @media (max-width: 60rem) {
    .nav__links { display: none; }
    .nav__menu { display: block; }
    .nav__right { margin-left: auto; }
  }
  @media (max-width: 40rem) {
    .nav__pill { padding-left: var(--space-md); gap: var(--space-xs); }
    .nav__brand { font-size: 1.25rem; }
    .nav__wa { display: none; }
    .nav__drawer-wa { display: flex !important; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav__menu summary { transition: none; }
  }
</style>
