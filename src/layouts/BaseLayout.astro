---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getMeals } from '../lib/content';
import { SITE_URL, BUSINESS_NAME, WA_BASE, WA_DIGITS, ADDRESS, FOUNDERS, MAPS_SEARCH } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const {
  title = "Frozen Meals Delivered in Pretoria North | Manna Kitchen",
  description = "Home-cooked frozen meals from two sisters in Theresapark, Pretoria North. Pasta and puddings from R50, delivered in Pretoria or collected.",
  type = "website",
  noindex = false,
  jsonLd = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Menu comes from meals.json, the same source the home page renders.
const meals = getMeals();
const menuItem = (m: (typeof meals)[number]) => ({
  "@type": "MenuItem",
  "name": m.name,
  "description": m.description,
  "offers": { "@type": "Offer", "price": String(m.price), "priceCurrency": "ZAR" },
});
const menuSections = [
  { name: 'Frozen meals', items: meals.filter((m) => m.category === 'meal') },
  { name: 'Puddings', items: meals.filter((m) => m.category === 'dessert') },
].filter((s) => s.items.length > 0);

// Structured data for LocalBusiness. Only facts JP supplied: no opening hours, geo,
// priceRange, rating or review. sameAs is omitted because no profile URLs were supplied.
const structuredData = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "FoodEstablishment"],
  "@id": `${SITE_URL}/#business`,
  "name": BUSINESS_NAME,
  "description": "Home-cooked frozen meals and puddings from two sisters in Theresapark, Pretoria North, delivered in Pretoria or collected from the kitchen.",
  "url": SITE_URL,
  "logo": `${SITE_URL}/images/brand/logo-badge.svg`,
  "image": `${SITE_URL}/og-image.png`,
  "telephone": `+${WA_DIGITS}`,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": ADDRESS.street,
    "addressLocality": `${ADDRESS.suburb}, ${ADDRESS.area}`,
    "addressRegion": ADDRESS.region,
    "postalCode": ADDRESS.postalCode,
    "addressCountry": ADDRESS.country,
  },
  "areaServed": [
    { "@type": "City", "name": "Pretoria" },
    { "@type": "Place", "name": "Pretoria North" },
  ],
  "founder": FOUNDERS.map((name) => ({ "@type": "Person", name })),
  "hasMap": MAPS_SEARCH,
  "hasMenu": {
    "@type": "Menu",
    "name": "Frozen meals and puddings",
    "hasMenuSection": menuSections.map((s) => ({
      "@type": "MenuSection",
      "name": s.name,
      "hasMenuItem": s.items.map(menuItem),
    })),
  },
  "potentialAction": {
    "@type": "OrderAction",
    "name": "Order on WhatsApp",
    "target": { "@type": "EntryPoint", "urlTemplate": WA_BASE },
  },
};
---

<!DOCTYPE html>
<html lang="en-ZA">
  <head>
    <!-- Basic Meta Tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Hallmark stamp, kept as plain text in every page so a render can read it; waivers live in src/styles/global.css -->
    <style is:inline>
/* Hallmark · shape: Letter · genre: editorial · theme: Garden recoloured to the logo purple (deal 1/3, seed frozen-home-cooked-comfort-meals-1b3c·ffd63b7c·2026-11-08·r0) · redesign: full · draw: 5b7302 · job: buy
 * hero: Counter (/), Banner (/about), Banner (/contact) · nav: floating pill · footer: colophon block · imagery: one photograph (the sisters, in the story); dish slots wait for the user's photographs · signature: the R55 and R50 offer set at display size beside the head
 * axes: light/roman-serif/chromatic-purple · posture: committed · contrast: pass · fold: pass · v2.0.0 */
    </style>

    <!-- Fonts: three families, self-hosted, display=swap -->
    <link rel="preload" href="/fonts/hanken-grotesk.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/vollkorn-600.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="light" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={BUSINESS_NAME} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={BUSINESS_NAME} />
    <meta property="og:locale" content="en_ZA" />
    <meta property="og:image" content={`${SITE_URL}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Manna Kitchen: frozen home-cooked meals delivered in Pretoria" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:image" content={`${SITE_URL}/og-image.png`} />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}

    <!-- Theme Color: the Garden paper -->
    <meta name="theme-color" content="#f7f1df" />
    <meta name="msapplication-TileColor" content="#f7f1df" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Header />

    <div id="main" tabindex="-1">
      <slot />
    </div>

    <Footer />

    <script is:inline>window.hallmarkSlots = (m) => { for (const [k, v] of Object.entries(m)) { const s = document.querySelector(`[data-slot="${k}"]`); if (!s) continue; const im = new Image(); im.src = typeof v === 'string' ? v : v.src; im.alt = (typeof v === 'object' && v.alt) || s.dataset.alt || ''; s.querySelectorAll(':scope > img').forEach((o) => o.remove()); s.prepend(im); } };
    document.querySelectorAll('[data-slot] img').forEach((i) => { if (i.complete && !i.naturalWidth) i.remove(); else i.addEventListener('error', () => i.remove(), { once: true }); });</script>
  </body>
</html>

<style is:global>
  @import url("../styles/global.css");
</style>
