---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title = "Frozen meals delivery in Pretoria | Manna Kitchen",
  description = "Home-cooked frozen meals, delivered in Pretoria or collected in Theresapark. Ready meals for seniors, people with disabilities and busy people.",
  type = "website",
  noindex = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteUrl = "https://manna.voogt.co.za";

// Structured Data for LocalBusiness.
// Only facts JP supplied: name, telephone, address, url, area served.
// No opening hours, geo, image, priceRange, rating or review: none has been supplied.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Manna Kitchen",
  "description": description,
  "@id": siteUrl,
  "url": siteUrl,
  "telephone": "+27825795210",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "71 Springbok St",
    "addressLocality": "Theresapark",
    "addressRegion": "Gauteng",
    "postalCode": "0182",
    "addressCountry": "ZA"
  },
  "areaServed": "Pretoria"
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Basic Meta Tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="frozen meals delivery Pretoria, ready meals for seniors, meals for elderly Pretoria, frozen meals for the disabled, meals for carers, home-cooked frozen meals, meal planning help, Pretoria North, Theresapark" />
    <meta name="author" content="Manna Kitchen" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Manna Kitchen" />
    <meta property="og:locale" content="en_ZA" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.svg" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Theme Color -->
    <meta name="theme-color" content="#8b5a3c" />
    <meta name="msapplication-TileColor" content="#8b5a3c" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Header />

    <div id="main" tabindex="-1">
      <slot />
    </div>

    <Footer />
  </body>
</html>

<style is:global>
  /* Hallmark · redesign: polish · theme: custom · frozen meals · tokens at :root · nav: wordmark left, five anchor links, WhatsApp and cart right, menu drawer on small screens · footer: three short link columns, no social row */
  /* Hallmark · pre-emit critique: P3 H4 E4 S3 R4 V3 · weakest: P, polish keeps the existing look so it argues little; spent the pass on contrast, tap targets and honest delivery copy instead */
  /* Hallmark · waive 39b · buttons stand 57px · the audience is older adults and people with limited dexterity, 48px+ targets are a requirement */
  /* Hallmark · waive 44c · hero is short on purpose · plain headline, one sentence and two actions, no decorative filler for readers who want the menu fast */
  /* Hallmark · waive 77 · closing section is a single prompt to chat on WhatsApp · it is the page's last action, not content */
  /* Hallmark · waive 71 · group titles sit 3rem under the section head and 1rem above their cards · measured gap includes the tonal image slot, not empty space */
  :root {
    --hue: 45;
    --paper: oklch(0.97 0.018 80);
    --paper-2: oklch(0.94 0.028 75);
    --paper-3: oklch(0.90 0.035 70);
    --surface: oklch(0.99 0.008 80);
    --ink: oklch(0.24 0.03 50);
    --ink-soft: oklch(0.38 0.025 50);
    --ink-mute: oklch(0.49 0.02 50);
    --line: oklch(0.82 0.025 70);
    --line-2: oklch(0.88 0.02 70);
    --field-edge: oklch(0.60 0.03 65);
    --accent: oklch(0.68 0.18 var(--hue));
    --accent-strong: oklch(0.58 0.19 var(--hue));
    --accent-ink: oklch(0.30 0.12 var(--hue));
    --accent-wash: oklch(0.95 0.06 var(--hue));
    --on-dark: oklch(0.99 0.008 80);
    --wa: oklch(0.64 0.17 150);
    --wa-strong: oklch(0.54 0.18 150);
    --wa-deep: oklch(0.46 0.13 150);
    --wa-deeper: oklch(0.38 0.11 150);
    --danger: oklch(0.50 0.19 27);
    --danger-wash: oklch(0.96 0.03 27);
    --success: oklch(0.45 0.11 150);
    --radius: 14px;
    --radius-lg: 22px;
    --shadow-sm: 0 1px 0 rgba(80,45,15,0.06), 0 1px 2px rgba(80,45,15,0.04);
    --shadow-md: 0 2px 4px rgba(80,45,15,0.05), 0 8px 24px -8px rgba(80,45,15,0.18);
    --shadow-lg: 0 30px 80px -20px rgba(80,45,15,0.35);
    --font-display: "Fraunces", "Playfair Display", Georgia, serif;
    --font-body: "Inter", system-ui, -apple-system, sans-serif;
    --content-w: 1240px;
    --density-pad: 5rem;
    --density-gap: 1.25rem;
    --tap: 48px;
    --header-h: 4.5rem;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html {
    scroll-behavior: smooth;
    overflow-x: clip;
    scrollbar-color: var(--line) var(--paper);
  }
  body {
    font-family: var(--font-body);
    background: var(--paper);
    color: var(--ink);
    font-size: 18px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
    caret-color: var(--accent-ink);
  }
  #main { flex: 1; min-width: 0; }
  #main:focus { outline: none; }
  [id] { scroll-margin-top: calc(var(--header-h) + 0.5rem); }
  ::selection { background: var(--accent-wash); color: var(--ink); }
  img, svg { display: block; max-width: 100%; }
  button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
  a { color: inherit; text-decoration: none; }
  h1, h2, h3 { overflow-wrap: break-word; min-width: 0; text-wrap: balance; }
  button:active:not(:disabled) { transform: translateY(1px); }

  :focus-visible {
    outline: 3px solid var(--accent-ink);
    outline-offset: 3px;
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: 0;
    z-index: 9999;
    transform: translateY(-200%);
    background: var(--ink);
    color: var(--on-dark);
    padding: 0.75rem 1.25rem;
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
    border-radius: 0 0 var(--radius) var(--radius);
    font-weight: 600;
  }
  .skip-link:focus-visible {
    transform: translateY(0);
    outline-color: var(--ink);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
