---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppProvider from '@/components/react/AppProvider';
---

<BaseLayout
  title="Your cart | Manna Kitchen"
  description="Review the frozen meals in your cart, then go to checkout. We deliver in Pretoria, or you can collect from our kitchen in Theresapark."
  noindex>

  <AppProvider page="cart" client:only="react" />
  <noscript>
    <p class="noscript-note">
      The cart needs JavaScript. You can still order by
      <a href="https://wa.me/27825795210">WhatsApp on +27 82 579 5210</a>.
    </p>
  </noscript>
</BaseLayout>

<style>
  :global(.cart-page) {
    max-width: var(--content-w);
    padding: 2rem 1.5rem;
    margin: 0 auto;
  }

  :global(.cart-page__header) {
    margin-bottom: 2rem;
  }

  :global(.breadcrumb) {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  :global(.breadcrumb a) {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  :global(.breadcrumb a:hover) {
    color: var(--ink);
  }

  :global(.breadcrumb__separator) {
    color: var(--ink-mute);
  }

  :global(.breadcrumb__current) {
    color: var(--ink-soft);
  }

  :global(.cart-page h1) {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--ink);
    margin: 0;
  }

  .noscript-note {
    max-width: 40rem;
    margin: 2rem auto;
    padding: 0 1.5rem;
    font-size: 1.125rem;
  }

  .noscript-note a {
    text-decoration: underline;
    color: var(--accent-ink);
  }

  @media (max-width: 640px) {
    :global(.cart-page) {
      padding: 1.5rem 1rem;
    }

    :global(.cart-page h1) {
      font-size: 1.9rem;
    }
  }
</style>
