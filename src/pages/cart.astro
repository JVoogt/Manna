---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppProvider from '@/components/react/AppProvider';
---

<BaseLayout title="Your Cart - Manna Kitchen">
  <AppProvider page="cart" client:only="react" />
</BaseLayout>

<style>
  :global(.cart-page) {
    max-width: 1200px;
    padding: 2rem 1.5rem;
    margin: 0 auto;
  }

  :global(.cart-page__header) {
    margin-bottom: 2rem;
  }

  :global(.breadcrumb) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }

  :global(.breadcrumb a) {
    color: var(--color-primary, #8b5a3c);
    text-decoration: none;
    transition: color 0.2s;
  }

  :global(.breadcrumb a:hover) {
    color: var(--color-text-dark, #6b4423);
    text-decoration: underline;
  }

  :global(.breadcrumb__separator) {
    color: var(--color-text-light, #999);
  }

  :global(.breadcrumb__current) {
    color: var(--color-text-light, #666);
  }

  :global(.cart-page h1) {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary, #8b5a3c);
    margin: 0;
  }

  @media (max-width: 640px) {
    :global(.cart-page) {
      padding: 1.5rem 1rem;
    }

    :global(.cart-page h1) {
      font-size: 1.75rem;
    }
  }
</style>
