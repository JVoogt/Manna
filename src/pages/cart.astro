---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppProvider from '@/components/react/AppProvider';
import { WA_BASE, WA_DISPLAY } from '@/lib/site';
---

<BaseLayout
  title="Your Order | Manna Kitchen, Pretoria North"
  description="Review the frozen meals in your order, then go to checkout. We deliver locally in Pretoria, or you can collect from our kitchen in Theresapark."
  noindex>

  <AppProvider page="cart" client:only="react" />
  <noscript>
    <p class="noscript-note">
      The cart needs JavaScript. You can still order by
      <a href={WA_BASE}>WhatsApp on {WA_DISPLAY}</a>.
    </p>
  </noscript>
</BaseLayout>

<style>
  :global(.cart-page) {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--space-xl) var(--gutter) var(--space-3xl);
  }

  :global(.cart-page__header) {
    margin-bottom: var(--space-xl);
  }

  :global(.breadcrumb) {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-bottom: var(--space-xs);
  }

  :global(.breadcrumb a) {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--color-ink);
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
  }

  :global(.breadcrumb__separator) { color: var(--color-muted); }
  :global(.breadcrumb__current) { color: var(--color-ink-2); }

  :global(.cart-page h1) {
    font-size: var(--text-section);
    max-width: none;
    margin: 0;
    text-wrap: balance;
  }

  .noscript-note {
    max-width: 40rem;
    margin: var(--space-xl) auto;
    padding-inline: var(--gutter);
    font-size: var(--text-lg);
  }

  .noscript-note a {
    color: var(--color-ink);
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
  }

  @media (max-width: 40rem) {
    :global(.cart-page) { padding-top: var(--space-xl); }
  }
</style>
