---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { WA_BASE, FOUNDERS } from '@/lib/site';
import '../styles/pages.css';
---

<BaseLayout
  title="Our Story | Manna Kitchen, Pretoria North"
  description="Two sisters, Cornelia Voogt and Edith Hawks, cook frozen meals in their home kitchen in Theresapark, Pretoria North. Read how Manna Kitchen began.">

  <main class="page">
    <section class="page-hero" aria-labelledby="about-title">
      <div class="container">
        <h1 id="about-title">Two sisters and a home kitchen.</h1>
        <p class="lead">Manna Kitchen cooks frozen meals in Theresapark, Pretoria North.</p>
      </div>
    </section>

    <section class="section--l began-section" aria-labelledby="began-h">
      <div class="container">
        <h2 id="began-h" class="began-title">How Manna began</h2>
        <ol class="began">
          <li>
            <h3>A hard season</h3>
            <p>Edith was diagnosed with Guillain-Barré syndrome, a rare neurological condition that needed long treatment and ongoing care. We needed a way to pay the medical bills.</p>
          </li>
          <li>
            <h3>So we cooked</h3>
            <p>We cooked the food we grew up with, in our home kitchen in Theresapark, Pretoria North.</p>
          </li>
          <li>
            <h3>The kitchen today</h3>
            <p>Word spread among neighbours and friends. People came back for the food and the care in every dish. Today we cook one thing: frozen meals for people who would rather not cook every day.</p>
          </li>
        </ol>
        <p class="began__sign">{FOUNDERS[0]} and {FOUNDERS[1]}</p>
      </div>
    </section>

    <section class="section--l" aria-labelledby="special-h">
      <div class="container split-rows">
        <h2 id="special-h">What makes Manna special</h2>
        <ul class="rows">
          <li><h3>Cooked at home</h3><p>Every meal is made in our own kitchen in Theresapark, with the same care we would give our own family.</p></li>
          <li><h3>Made for easy days</h3><p>Stock the freezer once and heat a meal when you need one. It takes the daily question of what to cook off your plate, or a carer’s.</p></li>
          <li><h3>Supporting family</h3><p>Ordering from Manna Kitchen supports a family business.</p></li>
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="order-h">
      <div class="container split-rows">
        <h2 id="order-h">How ordering works</h2>
        <div>
          <ol class="rows rows--steps">
            <li><h3>Choose your meals</h3><p>Pick from the menu and add them to your order.</p></li>
            <li><h3>Delivery or pickup</h3><p>Choose a preferred date at least 2 business days ahead.</p></li>
            <li><h3>Send it on WhatsApp</h3><p>We confirm the order with you, and quote the delivery fee if you chose delivery.</p></li>
            <li><h3>Pay by EFT or cash</h3><p>Cash when you collect. We deliver in Pretoria, or you collect at 71 Springbok St, Theresapark.</p></li>
          </ol>
          <p class="more">
            Questions? <a href={WA_BASE} target="_blank" rel="noopener noreferrer">Message us on WhatsApp</a>,
            or see the <a href="/#menu">frozen meals menu</a> and <a href="/contact/">how to find the kitchen</a>.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
