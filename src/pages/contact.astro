---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { WA_HELLO, WA_DISPLAY, ADDRESS, MAPS_EMBED, MAPS_SEARCH, MAPS_DIRECTIONS } from '@/lib/site';
import '../styles/pages.css';
---

<BaseLayout
  title="Contact Manna Kitchen | Theresapark, Pretoria North"
  description="Contact Manna Kitchen on WhatsApp, +27 63 351 0528. Find our kitchen at 71 Springbok St, Theresapark, Pretoria North, and ask about delivery in Pretoria.">

  <main class="page">
    <section class="page-hero" aria-labelledby="contact-title">
      <div class="container">
        <h1 id="contact-title">Contact Manna Kitchen</h1>
        <p class="lead">Message us on WhatsApp to order or to ask a question.</p>
        <div class="actions">
          <a href={WA_HELLO} class="btn btn--primary" target="_blank" rel="noopener noreferrer">Message us on WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="section--l" aria-labelledby="find-title">
      <div class="container">
        <h2 id="find-title" class="find-title">Where to find us</h2>
        <div class="find">
          <div class="find__facts">
            <p class="find__label">WhatsApp</p>
            <a class="find__number numeral" href={WA_HELLO} target="_blank" rel="noopener noreferrer">{WA_DISPLAY}</a>
            <p class="find__label">The kitchen</p>
            <address class="find__address">
              {ADDRESS.street}<br>
              {ADDRESS.suburb}, {ADDRESS.area}<br>
              {ADDRESS.postalCode}
            </address>
          </div>

          <section class="map" aria-label="Map to Manna Kitchen">
            <iframe
              title="Map to Manna Kitchen, 71 Springbok St, Theresapark"
              src={MAPS_EMBED}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              width="640"
              height="480"></iframe>
            <div class="map__links">
              <a class="btn" href={MAPS_SEARCH} target="_blank" rel="noopener noreferrer">Open in Google Maps</a>
              <a class="btn" href={MAPS_DIRECTIONS} target="_blank" rel="noopener noreferrer">Directions</a>
            </div>
          </section>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="deliver-title">
      <div class="container split-rows">
        <h2 id="deliver-title">Delivery and collection</h2>
        <dl class="facts">
          <div>
            <dt>Delivery</dt>
            <dd>We deliver locally in Pretoria. The fee is quoted on WhatsApp when you order.</dd>
          </div>
          <div>
            <dt>Collection</dt>
            <dd>Collect from the kitchen. We arrange the time on WhatsApp.</dd>
          </div>
          <div>
            <dt>Order ahead</dt>
            <dd>At least 2 business days.</dd>
          </div>
          <div>
            <dt>Payment</dt>
            <dd>EFT, or cash when you collect.</dd>
          </div>
        </dl>
      </div>
    </section>
  </main>
</BaseLayout>
