---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/ContactForm.astro';
---

<BaseLayout
  title="Contact Us - Manna Kitchen | WhatsApp Orders"
  description="Contact Manna Kitchen for orders and inquiries. WhatsApp: +27 82 579 5210. Pickup at 71 Springbok St, Theresapark, Pretoria. Fast, friendly service.">

  <article class="contact-page">
    <section class="hero">
      <h1>Get in Touch</h1>
      <p class="hero-subtitle">
        We'd love to hear from you! Reach out to place an order or ask questions.
      </p>
    </section>

    <section class="contact-methods">
      <div class="primary-contact">
        <div class="contact-card whatsapp-card">
          <div class="contact-icon">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M24 0C10.745 0 0 10.745 0 24c0 4.243 1.105 8.228 3.043 11.686L0.5 47.5l12.282-2.486C16.069 46.886 19.934 48 24 48c13.255 0 24-10.745 24-24S37.255 0 24 0z" fill="#25D366"/>
              <path d="M35.5 12.375C32.831 9.704 29.189 8.188 25.313 8.188c-7.986 0-14.484 6.498-14.484 14.484 0 2.553.664 5.042 1.93 7.237L10.5 37.5l7.791-2.241c2.084 1.137 4.429 1.741 6.824 1.741h.006c7.986 0 14.484-6.498 14.484-14.484 0-3.876-1.513-7.521-4.105-10.141zM25.313 34.688c-2.16 0-4.277-.58-6.13-1.676l-.44-.261-4.557 1.194 1.216-4.448-.286-.457c-1.203-1.913-1.838-4.124-1.838-6.415 0-6.638 5.402-12.04 12.04-12.04 3.216 0 6.237 1.254 8.509 3.529s3.529 5.293 3.529 8.509c-.005 6.641-5.405 12.065-12.043 12.065zm6.602-9.008c-.362-.181-2.143-1.057-2.475-1.178-.331-.121-.572-.181-.814.181-.242.362-.936 1.178-1.147 1.42-.211.242-.422.271-.784.09-.362-.181-1.527-.563-2.908-1.795-1.075-.959-1.801-2.143-2.012-2.505-.211-.362-.022-.558.159-.738.163-.163.362-.422.543-.633.181-.211.241-.362.362-.603.121-.242.06-.453-.03-.633-.09-.181-.814-1.962-1.115-2.686-.293-.705-.592-.609-.814-.62-.211-.011-.453-.013-.694-.013s-.633.09-0.965.453c-.331.362-1.266 1.238-1.266 3.019s1.296 3.502 1.477 3.744c.181.242 2.553 3.898 6.184 5.467.864.373 1.539.596 2.065.763.867.275 1.656.236 2.281.143.696-.104 2.143-.876 2.445-1.721.302-.846.302-1.571.211-1.721-.09-.15-.331-.242-.694-.422z" fill="white"/>
            </svg>
          </div>
          <h2>WhatsApp Us</h2>
          <p class="contact-intro">
            Our favorite way to connect! Quick responses, easy ordering, and friendly chats.
          </p>
          <a href="https://wa.me/27825795210" class="whatsapp-link" target="_blank" rel="noopener noreferrer">
            <span class="phone-number">+27 82 579 5210</span>
            <span class="link-text">Chat on WhatsApp</span>
          </a>
          <p class="contact-note">
            We love chatting with our customers! Message us anytime for orders or questions.
          </p>
        </div>
      </div>

      <div class="secondary-contacts">
        <div class="contact-card">
          <h3>Phone</h3>
          <p>
            Prefer a call? You can reach us at:
          </p>
          <a href="tel:+27825795210" class="phone-link">
            +27 82 579 5210
          </a>
        </div>

        <div class="contact-card">
          <h3>Pickup Location</h3>
          <p>
            All orders are available for pickup at our location in Theresapark:
          </p>
          <address class="address">
            71 Springbok St<br>
            Theresapark<br>
            Pretoria, 0182
          </address>
          <p class="address-note">
            We'll confirm the exact pickup time and details when you order.
          </p>
        </div>
      </div>
    </section>

    <section class="web-inquiry">
      <h2>Send Us a Message</h2>
      <p class="section-intro">
        Have a question or special request? Fill out the form below and we'll get back to you.
      </p>
      <ContactForm />
    </section>
  </article>
</BaseLayout>

<style>
  .contact-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 1rem;
  }

  .hero {
    text-align: center;
    padding: 2rem 0 3rem;
    border-bottom: 3px solid #8b5a3c;
    margin-bottom: 3rem;
  }

  .hero h1 {
    font-size: 2.5rem;
    color: #6b4423;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: #8b5a3c;
  }

  .contact-methods {
    margin-bottom: 4rem;
  }

  .primary-contact {
    margin-bottom: 2rem;
  }

  .contact-card {
    background: #fdf8f3;
    border: 2px solid #e8d4bc;
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 1.5rem;
  }

  .whatsapp-card {
    background: linear-gradient(135deg, #fdf8f3 0%, #f5efe6 100%);
    border: 3px solid #25D366;
    text-align: center;
  }

  .contact-icon {
    display: flex;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .contact-card h2 {
    font-size: 2rem;
    color: #6b4423;
    margin-bottom: 1rem;
  }

  .contact-card h3 {
    font-size: 1.5rem;
    color: #8b5a3c;
    margin-bottom: 0.75rem;
  }

  .contact-card p {
    font-size: 1rem;
    color: #4a3728;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .contact-intro {
    font-size: 1.125rem;
    color: #6b4423;
    margin-bottom: 1.5rem;
  }

  .whatsapp-link {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    background: #25D366;
    color: white;
    padding: 1.25rem 2rem;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.2s, transform 0.1s;
    margin: 1rem 0;
  }

  .whatsapp-link:hover {
    background: #20ba56;
    transform: scale(1.02);
  }

  .phone-number {
    font-size: 1.5rem;
    letter-spacing: 0.5px;
  }

  .link-text {
    font-size: 1.125rem;
  }

  .contact-note {
    font-size: 0.95rem;
    font-style: italic;
    color: #8b5a3c;
    margin-top: 1rem;
  }

  .secondary-contacts {
    display: grid;
    gap: 1.5rem;
  }

  .phone-link {
    display: inline-block;
    font-size: 1.25rem;
    font-weight: 600;
    color: #8b5a3c;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 2px solid #d4a574;
    border-radius: 8px;
    transition: background 0.2s;
  }

  .phone-link:hover {
    background: #fef6ed;
  }

  .address {
    font-style: normal;
    font-size: 1.125rem;
    line-height: 1.8;
    color: #6b4423;
    font-weight: 500;
    margin: 1rem 0;
  }

  .address-note {
    font-size: 0.9rem;
    font-style: italic;
    color: #8b7355;
  }

  .web-inquiry {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 2px solid #e8d4bc;
  }

  .web-inquiry h2 {
    font-size: 2rem;
    color: #6b4423;
    text-align: center;
    margin-bottom: 1rem;
  }

  .section-intro {
    text-align: center;
    font-size: 1.125rem;
    color: #8b5a3c;
    margin-bottom: 2rem;
  }

  /* Mobile responsive */
  @media (max-width: 640px) {
    .contact-page {
      padding: 0.75rem;
    }

    .hero h1 {
      font-size: 2rem;
    }

    .hero-subtitle {
      font-size: 1.125rem;
    }

    .contact-card {
      padding: 1.5rem;
    }

    .contact-card h2 {
      font-size: 1.75rem;
    }

    .phone-number {
      font-size: 1.25rem;
    }

    .link-text {
      font-size: 1rem;
    }
  }

  @media (min-width: 641px) {
    .secondary-contacts {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
