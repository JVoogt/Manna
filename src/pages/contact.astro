---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact | Manna Kitchen, Pretoria"
  description="Order frozen meals from Manna Kitchen on WhatsApp, +27 82 579 5210. We deliver in Pretoria, or you can collect at 71 Springbok St, Theresapark.">

  <main class="contact-page">
    <header class="hero">
      <h1>Get in touch</h1>
      <p class="hero-subtitle">Order, ask a question, or tell us what you need.</p>
    </header>

    <section class="contact-methods" aria-labelledby="wa-h">
      <div class="contact-card whatsapp-card">
        <svg class="wa-icon" width="40" height="40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.5 14.3c-.3-.15-1.7-.84-2-.94-.27-.1-.47-.15-.66.15-.2.3-.76.94-.93 1.13-.17.2-.34.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.13.3-.34.44-.51.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.66-1.6-.9-2.18-.24-.58-.48-.5-.66-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.47 1.06 2.88 1.21 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.22 1.35.19 1.86.12.57-.08 1.74-.71 1.99-1.4.25-.69.25-1.28.17-1.4-.07-.13-.27-.2-.57-.35zM12 2C6.48 2 2 6.48 2 12c0 1.95.56 3.77 1.53 5.31L2 22l4.79-1.49A9.95 9.95 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2z"/>
        </svg>
        <h2 id="wa-h">WhatsApp us</h2>
        <p class="contact-intro">
          The quickest way to order. We reply, confirm your meals, and quote the delivery fee.
        </p>
        <a href="https://wa.me/27825795210" class="whatsapp-link" target="_blank" rel="noopener noreferrer">
          <span class="phone-number">+27 82 579 5210</span>
          <span class="link-text">Chat on WhatsApp</span>
        </a>
      </div>
    </section>

    <section class="secondary-contacts" aria-label="Other ways to reach us">
      <div class="contact-card">
        <h2>Phone</h2>
        <p>Prefer a call? You can reach us on:</p>
        <a href="tel:+27825795210" class="phone-link">+27 82 579 5210</a>
      </div>

      <div class="contact-card">
        <h2>Delivery and pickup</h2>
        <p>
          We deliver in Pretoria. The delivery fee is quoted on WhatsApp when you order.
        </p>
        <p>Or collect your order from our kitchen:</p>
        <address class="address">
          71 Springbok St<br>
          Theresapark<br>
          Pretoria, 0182
        </address>
        <p class="address-note">
          We confirm the date and time with you when you order. Please give us at least 2
          business days.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .contact-page {
    max-width: 62rem;
    margin: 0 auto;
    padding: 1rem 1.25rem 3rem;
  }

  h1, h2, h3 {
    font-family: var(--font-display);
    color: var(--ink);
    overflow-wrap: break-word;
    min-width: 0;
  }

  .hero {
    padding: 2rem 0 2.5rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 2.5rem;
  }

  .hero h1 {
    font-size: 2.75rem;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--ink-soft);
  }

  .contact-methods { margin-bottom: 1.5rem; }

  .contact-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2rem;
  }

  .whatsapp-card {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .wa-icon {
    color: var(--wa-deep);
    margin-bottom: 0.75rem;
  }

  .contact-card h2 {
    font-size: 1.75rem;
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .contact-card p {
    font-size: 1.0625rem;
    color: var(--ink-soft);
    line-height: 1.6;
    margin-bottom: 1rem;
    max-width: 65ch;
  }

  .contact-intro { margin-bottom: 1.5rem; }

  .whatsapp-link {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    background: var(--wa-deep);
    color: var(--on-dark);
    padding: 1.1rem 2rem;
    min-height: var(--tap);
    border-radius: var(--radius);
    font-weight: 600;
    transition: background-color 200ms ease, transform 120ms ease;
  }

  .whatsapp-link:hover { background: var(--wa-deeper); }
  .whatsapp-link:active { transform: translateY(1px); }

  .phone-number {
    font-size: 1.5rem;
    font-variant-numeric: tabular-nums;
  }

  .link-text { font-size: 1.125rem; }

  .secondary-contacts {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(0, 1fr);
    margin-bottom: 3rem;
  }

  .phone-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: 1.25rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--accent-ink);
    padding: 0 1.25rem;
    border: 2px solid var(--field-edge);
    border-radius: var(--radius);
    transition: background-color 200ms ease;
  }

  .phone-link:hover { background: var(--paper-2); }
  .phone-link:active { background: var(--paper-3); }

  .address {
    font-style: normal;
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--ink);
    font-weight: 500;
    margin: 0 0 1rem;
  }

  .address-note {
    font-size: 1rem;
    color: var(--ink-mute);
    margin-bottom: 0;
  }

  .whatsapp-link:focus-visible,
  .phone-link:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  .hero h1, .contact-card h2 { text-wrap: balance; }

  @media (max-width: 640px) {
    .contact-page { padding: 0.75rem 1rem 2.5rem; }
    .hero h1 { font-size: 2.25rem; }
    .contact-card { padding: 1.5rem; }
    .contact-card h2 { font-size: 1.5rem; }
    .phone-number { font-size: 1.25rem; }
  }

  @media (min-width: 641px) {
    .secondary-contacts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-link, .phone-link { transition: none; }
  }
</style>
