---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProducts, getMeals } from '@/lib/content';
import AppProvider from '@/components/react/AppProvider';

const products = getProducts();
const meals = getMeals();
---

<BaseLayout title="Manna Kitchen - Build Your Perfect Platter">
  <AppProvider page="home" products={products} meals={meals} client:only="react" />
</BaseLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;900&family=Karla:wght@400;500;600;700&display=swap');

  /* Tab Styling */
  .tab-list {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 3rem;
    justify-content: center;
    border-bottom: 3px solid rgba(139, 90, 60, 0.15);
    padding-bottom: 1rem;
  }

  .tab {
    font-family: 'Karla', sans-serif;
    padding: 0.875rem 2.5rem;
    font-size: 1.05rem;
    font-weight: 700;
    background: transparent;
    border: none;
    border-bottom: 4px solid transparent;
    color: #8b7355;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    min-height: 48px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    position: relative;
  }

  .tab::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 50%;
    width: 0;
    height: 4px;
    background: linear-gradient(90deg, #8b5a3c 0%, #d4a574 100%);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    transform: translateX(-50%);
  }

  .tab:hover {
    color: #8b5a3c;
  }

  .tab:hover::after {
    width: 100%;
  }

  .tab[data-headlessui-state="selected"] {
    color: #4a3728;
    font-weight: 700;
  }

  .tab[data-headlessui-state="selected"]::after {
    width: 100%;
  }

  .tab-panels {
    margin-top: 2rem;
  }

  /* Product Grid */
  .product-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 968px) {
    .product-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .product-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 640px) {
    .tab {
      padding: 0.75rem 1.5rem;
      font-size: 0.9rem;
    }

    .product-grid {
      gap: 1.5rem;
    }
  }
</style>
