---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProducts, getMeals } from '@/lib/content';
import AppProvider from '@/components/react/AppProvider';

const products = getProducts();
const meals = getMeals();
---

<BaseLayout title="Manna Kitchen - Build Your Perfect Platter | Theresapark, Pretoria">
  <AppProvider page="home" products={products} meals={meals} client:only="react" />
</BaseLayout>
