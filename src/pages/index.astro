---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getMeals } from '@/lib/content';
import { FAQ_ITEMS } from '@/lib/faq';
import { WA_DISPLAY } from '@/lib/site';
import AppProvider from '@/components/react/AppProvider';

const meals = getMeals();

// FAQPage JSON-LD from the same list the page renders.
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": FAQ_ITEMS.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<BaseLayout
  title="Frozen Meals Delivered in Pretoria North | Manna Kitchen"
  description="Home-cooked frozen meals from two sisters in Theresapark, Pretoria North. Pasta and puddings from R50, delivered in Pretoria or collected."
  jsonLd={[faqLd]}
>
  <AppProvider page="home" meals={meals} client:load />
  <noscript>
    <p class="noscript-note">
      Adding meals to your order needs JavaScript. Message us on WhatsApp {WA_DISPLAY} to order.
    </p>
  </noscript>
</BaseLayout>

<style>
  .noscript-note {
    max-width: 40rem;
    margin: var(--space-xl) auto;
    padding-inline: var(--gutter);
    font-size: var(--text-lg);
  }
</style>
