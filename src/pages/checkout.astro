---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppProvider from '@/components/react/AppProvider';
import { WA_BASE, WA_DISPLAY } from '@/lib/site';
---

<BaseLayout
  title="Checkout | Manna Kitchen, Pretoria North"
  description="Choose delivery or pickup, pick a preferred date and send your frozen meals order to Manna Kitchen on WhatsApp. Pay by EFT, or cash when you collect."
  noindex>

  <AppProvider page="checkout" client:only="react" />
  <noscript>
    <p class="noscript-note">
      Checkout needs JavaScript. You can still order by
      <a href={WA_BASE}>WhatsApp on {WA_DISPLAY}</a>.
    </p>
  </noscript>
</BaseLayout>

<style>
  :global(.checkout-page) {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--space-xl) var(--gutter) var(--space-3xl);
  }

  :global(.checkout-page h1) {
    font-size: var(--text-section);
    max-width: none;
    margin: 0 0 var(--space-xl) 0;
    text-wrap: balance;
  }

  .noscript-note {
    max-width: 40rem;
    margin: var(--space-xl) auto;
    padding-inline: var(--gutter);
    font-size: var(--text-lg);
  }

  .noscript-note a {
    color: var(--color-ink);
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
  }

  @media (max-width: 40rem) {
    :global(.checkout-page) { padding-top: var(--space-xl); }
  }
</style>
