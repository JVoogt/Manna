---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CheckoutForm from '@/components/react/CheckoutForm';
---

<BaseLayout title="Checkout - Manna Kitchen">
  <section class="checkout-page">
    <h1>Checkout</h1>
    <CheckoutForm client:load />
  </section>
</BaseLayout>

<style>
  .checkout-page {
    max-width: 1000px;
    padding: 2rem 1.5rem;
    margin: 0 auto;
  }

  .checkout-page h1 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 2rem 0;
  }

  @media (max-width: 768px) {
    .checkout-page {
      padding: 1.5rem 1rem;
    }

    .checkout-page h1 {
      font-size: 1.75rem;
      margin-bottom: 1.5rem;
    }
  }
</style>
