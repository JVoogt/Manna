---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppProvider from '@/components/react/AppProvider';
---

<BaseLayout
  title="Checkout - Manna Kitchen | Complete Your Order"
  description="Complete your Manna Kitchen order. Enter delivery details and submit via WhatsApp. Fresh homemade food ready for pickup in Theresapark, Pretoria.">

  <AppProvider page="checkout" client:only="react" />
</BaseLayout>

<style>
  :global(.checkout-page) {
    max-width: 1000px;
    padding: 2rem 1.5rem;
    margin: 0 auto;
  }

  :global(.checkout-page h1) {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 2rem 0;
  }

  @media (max-width: 768px) {
    :global(.checkout-page) {
      padding: 1.5rem 1rem;
    }

    :global(.checkout-page h1) {
      font-size: 1.75rem;
      margin-bottom: 1.5rem;
    }
  }
</style>
